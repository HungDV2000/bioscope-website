# ──────────────────────────────────────────────────────────────────
# DV-CMS — Environment variables (PRODUCTION template)
# ──────────────────────────────────────────────────────────────────
#
# Stack chạy qua docker-compose với 3 services: db + cms + frontend.
# Mọi port theo dải 26xxx để tránh xung đột với:
#   - BioBot (dải 15xxx: 15432, 15678, 16333, 16379…)
#   - PM2 services cũ (dải 26xxx dùng chung cho HTTP 26080/26081, v.v.)
#   - nginx host mặc định (80/443 do aaPanel/Caddy quản lý)
#
# aaPanel reverse proxy → trỏ domain vào 2 host port:
#   - admin.bioscope.vn → 127.0.0.1:26081 (CMS / Payload admin)
#   - web.bioscope.vn   → 127.0.0.1:26080 (Frontend)
#
# ─── Host ports (bind ra 127.0.0.1) ───
# DVCMS_DB_HOST_PORT=26432          # Postgres host port (debug trực tiếp từ host)
# DVCMS_CMS_HOST_PORT=26081         # CMS container (Payload admin)
# DVCMS_FRONTEND_HOST_PORT=26080    # Frontend container (Next.js public site)
#
# ─── Container internal ports (KHÔNG bind ra host, dải 26xxx) ───
# CMS container      : 26301
# Frontend container: 26300
# Postgres container : 5432    (chỉ truy cập từ cms/frontend trong bridge network)
#
# ─── URLs công khai (baked vào client bundle khi build frontend) ───
# NEXT_PUBLIC_CMS_URL=https://admin.bioscope.vn
# NEXT_PUBLIC_SITE_URL=https://web.bioscope.vn
# PAYLOAD_PUBLIC_SERVER_URL=https://admin.bioscope.vn
# FRONTEND_URL=https://web.bioscope.vn
#
# ─── Dev local (không Docker) — KHÔNG dùng file này ─────────────
# Dev local dùng .env riêng trong apps/core-cms/.env với localhost:3001
# (chi tiết xem docs/01-local-development.md)
# ──────────────────────────────────────────────────────────────────

# ── Database (bên trong docker network) ──
DATABASE_URI=postgres://dvcms:CHANGE_ME@db:5432/dvcms

# ── Host ports (dải 26xxx, bind 127.0.0.1) ──
DVCMS_DB_HOST_PORT=26432
DVCMS_CMS_HOST_PORT=26081
DVCMS_FRONTEND_HOST_PORT=26080

# ── Public URLs (dùng cho build + cookies + revalidate hook) ──
NEXT_PUBLIC_CMS_URL=https://admin.bioscope.vn
NEXT_PUBLIC_SITE_URL=https://web.bioscope.vn
PAYLOAD_PUBLIC_SERVER_URL=https://admin.bioscope.vn
FRONTEND_URL=https://web.bioscope.vn

# ── Container internal port (CMS — 26301, Frontend — 26300) ──
# Biến PORT chỉ dùng để Payload/Next biết đang chạy ở port nào trong container.
# Trong docker-compose, ENV PORT khớp với ARG CMS_INTERNAL_PORT trong Dockerfile.
PORT=26301

# ── Secrets (TẠO MỚI cho mỗi môi trường — openssl rand -hex 32) ──
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
PAYLOAD_SECRET=CHANGE_ME_PAYLOAD_SECRET_HEX_64
REVALIDATE_SECRET=CHANGE_ME_REVALIDATE_SECRET_HEX_32

# ── Payload config ──
B2B_COOKIE=bio-token

# ── Google Drive sync (optional) ──
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=/app/apps/core-cms/credentials/service-account.json

# ── OpenAI (AI Generate — GPT-5.6 + gpt-image-2) ──
# API key from https://platform.openai.com/api-keys
# Required for "Tạo nội dung tự động" feature
OPENAI_API_KEY=

# Model overrides (optional — bỏ trống để dùng mặc định trong openaiService.ts).
#   Content/Vision: gpt-5.6-terra (cân bằng) | gpt-5.6-sol (mạnh nhất) | gpt-5.6-luna (rẻ) | gpt-4o (legacy)
#   Image: gpt-image-2 (mặc định) | gpt-image-1.5 | gpt-image-1 | gpt-image-1-mini
#   ⚠️ Các model gpt-image yêu cầu Organization Verification trong OpenAI console.
OPENAI_CONTENT_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024

# ── Giới hạn thời gian gọi OpenAI (tùy chọn) ──
# Hàng đợi AI chạy TUẦN TỰ: một call treo sẽ chặn mọi nguyên liệu phía sau.
# Thời gian chiếm hàng đợi tối đa = OPENAI_TIMEOUT_MS × (1 + OPENAI_MAX_RETRIES).
OPENAI_TIMEOUT_MS=180000
OPENAI_MAX_RETRIES=1

# ── Ước tính chi phí (tùy chọn) ──
# Job luôn ghi lại số token. Điền 3 giá dưới thì job ghi thêm ước tính USD.
# CỐ Ý không hard-code giá trong code: giá model thay đổi, hằng số cũ sẽ âm thầm
# cho ra con số sai. Lấy giá hiện hành tại https://openai.com/api/pricing
# OPENAI_PRICE_INPUT_PER_1M=
# OPENAI_PRICE_OUTPUT_PER_1M=
# OPENAI_PRICE_PER_IMAGE=

# ── Hàng đợi AI (tùy chọn) ──
# AI_QUEUE_GAP_MS: nghỉ giữa 2 job (mặc định 2000).
# AI_QUEUE_STUCK_AFTER_MS: job đang chạy quá thời gian này bị coi là bỏ rơi
# (container restart giữa chừng) và được xếp lại hàng đợi. Mặc định 30 phút.
# Việc quét chỉ chạy lúc BẮT ĐẦU một lượt drain — thời điểm không có job nào
# đang chạy trong process này — nên job dài không bị cắt ngang. Chỉ cần tăng
# giá trị này nếu về sau chạy nhiều container CMS song song cùng một database.
# AI_QUEUE_GAP_MS=2000
# AI_QUEUE_STUCK_AFTER_MS=1800000

# ── Better Editor — same-origin preview (TÙY CHỌN) ──
# Chỉ bật khi muốn click-to-edit trong Better Editor. Cần chạy service
# preview-proxy VÀ trỏ admin.bioscope.vn qua proxy (26082) trong nginx/aaPanel.
# Xem docs/better-editor-preview.md. Để trống = admin chạy trực tiếp (26081) bình thường.
#
#   1) Bỏ comment 2 dòng dưới
#   2) docker compose build cms && docker compose up -d cms
#   3) docker compose --profile preview up -d preview-proxy
#   4) nginx: admin.bioscope.vn → 127.0.0.1:26082 (thay vì 26081)
#
# CMS_ASSET_PREFIX=/cms-static
# PREVIEW_ORIGIN=https://admin.bioscope.vn
# DVCMS_PREVIEW_HOST_PORT=26082    # host port của preview-proxy (mặc định 26082)
