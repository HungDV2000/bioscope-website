# ── LEGACY: Production env cho PM2 (KHÔNG dùng Docker nginx) ──
# ──────────────────────────────────────────────────────────────────
# File này dành cho setup CŨ chạy trực tiếp trên VPS qua PM2 + aaPanel.
# Nếu bạn dùng docker-compose mới (install.sh + nginx container nội bộ),
# dùng .env.example thay thế.
#
# Setup cũ:
#   - Frontend  chạy qua PM2 (port 26000) + aaPanel proxy
#   - CMS       chạy qua PM2 (port 26001) + aaPanel proxy
#   - Database  chạy qua docker-compose hoặc PM2 (port 15432 hoặc 26432)
#
# Docs: docs/03-frontend-only-preview.md
# ──────────────────────────────────────────────────────────────────

# Host ports cho aaPanel/nginx external reverse proxy
# (đã có file docs/snippets/aapanel-nginx-*.conf dùng các port này)
DVCMS_DB_HOST_PORT=26432
DVCMS_CMS_HOST_PORT=26001
DVCMS_FRONTEND_HOST_PORT=26000

# Public domains.
PAYLOAD_PUBLIC_SERVER_URL=https://admin.bioscope.vn
NEXT_PUBLIC_CMS_URL=https://admin.bioscope.vn
NEXT_PUBLIC_SITE_URL=https://web.bioscope.vn
FRONTEND_URL=https://web.bioscope.vn

# Secrets — REGENERATE all of these for production:  openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
PAYLOAD_SECRET=CHANGE_ME_openssl_rand_hex_32
# Must be IDENTICAL for the cms + frontend services (revalidate handshake).
REVALIDATE_SECRET=CHANGE_ME_openssl_rand_hex_32

B2B_COOKIE=bio-token

# OpenAI (AI Generate). gpt-image-* cần Organization Verification trong OpenAI console.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024