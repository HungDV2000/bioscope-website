# ── Production env for docker-compose (copy to .env.server, fill real secrets) ──
# Frontend  → https://web.bioscope.vn   (container 3000 → host 127.0.0.1:26000)
# Admin/CMS → https://admin.bioscope.vn (container 3001 → host 127.0.0.1:26001)

# Host ports the reverse proxy (nginx / aaPanel) forwards to.
DVCMS_DB_HOST_PORT=26432
DVCMS_CMS_HOST_PORT=26001
DVCMS_FRONTEND_HOST_PORT=26000

# Public domains.
PAYLOAD_PUBLIC_SERVER_URL=https://admin.bioscope.vn
NEXT_PUBLIC_CMS_URL=https://admin.bioscope.vn
NEXT_PUBLIC_SITE_URL=https://web.bioscope.vn
FRONTEND_URL=https://web.bioscope.vn

# Secrets — REGENERATE all of these for production:  openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
PAYLOAD_SECRET=CHANGE_ME_openssl_rand_hex_32
# Must be IDENTICAL for the cms + frontend services (revalidate handshake).
REVALIDATE_SECRET=CHANGE_ME_openssl_rand_hex_32

B2B_COOKIE=bio-token
