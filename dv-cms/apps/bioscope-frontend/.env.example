# Base URL of the shared Payload backend (@dv/core-cms)
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# Canonical public site origin — used by sitemap.xml, robots.txt, canonical
# tags, JSON-LD and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://web.bioscope.vn

# B2B member API (Payload /api/b2b/*). Leave empty to use mock demo login.
# NEXT_PUBLIC_B2B_API_URL=http://localhost:3001

# Shared secret with the CMS revalidate hook (must match core-cms .env).
# Generate a strong random value in production (openssl rand -hex 32).
REVALIDATE_SECRET=

# ── Security / WAF (lib/security) ──────────────────────────────────────────
# Set to "off" to disable the firewall entirely.
# SECURITY_WAF=on
# Comma-separated IPs to always block / always allow (bypass all rules).
# SECURITY_BLOCKED_IPS=
# SECURITY_ALLOWED_IPS=
# Per-IP page-request rate limit per minute (DoS guard). Default 240.
# SECURITY_RATE_MAX=240
